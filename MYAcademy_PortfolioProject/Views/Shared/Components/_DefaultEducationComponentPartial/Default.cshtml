@model List<Education>

<section id="education" class="bg-white border-top border-bottom">
    <div class="container">
        <div class="row gy-5 align-items-center">

            <!-- Sol Taraf: Eğitim Hayatım (col-lg-7) -->
            <div class="col-lg-7 reveal-on-scroll">
                <div class="eyebrow-badge">
                    <i class="bi bi-mortarboard-fill"></i> AKADEMİK YOLCULUK
                </div>
                <h2 class="section-title mb-4">
                    Eğitim Hayatım
                </h2>

                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model)
                    {
                        <div class="p-4 rounded-4 border bg-light">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <h3 class="h5 fw-bold mb-0">@item.EducationTitle</h3>
                                <span class="badge bg-secondary-subtle text-dark">@item.badge</span>
                            </div>
                            <p class="text-muted small mb-0">
                                @item.EducationDescription
                            </p>
                        </div>
                    }
                </div>
            </div> <!-- col-lg-7 BURADA KAPANIYOR -->
            <!-- Sağ Taraf: Alıntı Bileşeni (İçerisinde col-lg-5 barındırıyor) -->
            @await Component.InvokeAsync("_DefaultQuoteComponentViewPartial")

        </div>
    </div>
</section>