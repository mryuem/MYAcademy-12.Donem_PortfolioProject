@model Experience

@{
    ViewData["Title"] = "CreateExperience";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="page-content-area">

    <div class="content-header-row">
        <div>
            <h2 class="page-title"> Deneyim Güncelleme Sayfası</h2>
            <p class="page-subtitle">Düzenleme işlemlerinizi gerçekleştirebilirsiniz.</p>
        </div>
    </div>

    <div class="side-drawer-card" style="margin-top:0;">
        <form method="post">
            <div class="row g-3">
                <input type="hidden" asp-for="ExperienceId"  /> 
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label-custom">Başlık</label>
                    <input asp-for="Title" class="form-control-custom" />
                </div>

                <div class="col-md-6">
                    <label asp-for="CompanyName" class="form-label-custom">Şirket</label>
                    <input asp-for="CompanyName" class="form-control-custom" />
                </div>
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label-custom">Kategori</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control-custom"></select>
                </div>

                <div class="col-md-6 d-flex align-items-end">
                    <label class="d-flex align-items-center gap-2 mb-2">
                        <input type="checkbox" asp-for="IsActive" class="custom-checkbox" />
                        <span class="form-label-custom mb-0">Sitede aktif olsun</span>
                    </label>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label-custom">Açıklama</label>
                    <textarea asp-for="Description" class="form-control-custom" rows="4"></textarea>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn-pastel-primary">
                    <i class="bi bi-check2-circle"></i>
                    <span>Kaydet</span>
                </button>
                <a asp-action="ExperienceList" class="btn-pastel-secondary">Vazgeç</a>
            </div>
        </form>
    </div>

</div>