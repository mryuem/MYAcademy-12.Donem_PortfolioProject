@model MYAcademy_PortfolioProject.Entities.Message

@{
    ViewData["Title"] = "Mesaj Detayı";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<style>
    .message-detail-card {
        background: #fff;
        border: 1px solid #ebe8e1;
        border-radius: 14px;
        padding: 28px;
        margin-top: 20px;
    }

    .message-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 25px;
    }

    .message-title {
        font-size: 20px;
        font-weight: 600;
        color: #303630;
        margin-bottom: 8px;
    }

    .message-date {
        font-size: 13px;
        color: #8a8a85;
    }

    .sender-info {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 0;
        border-top: 1px solid #f0eee9;
        border-bottom: 1px solid #f0eee9;
        margin-bottom: 25px;
    }

    .sender-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #e7efe9;
        color: #2f5d4e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        font-weight: 600;
        flex-shrink: 0;
    }

    .sender-name {
        font-size: 14px;
        font-weight: 600;
        color: #303630;
        margin-bottom: 4px;
    }

    .sender-email {
        font-size: 13px;
        color: #8a8a85;
    }

    .message-content-title {
        font-size: 13px;
        font-weight: 600;
        color: #777;
        margin-bottom: 12px;
    }

    .message-content {
        font-size: 14px;
        line-height: 1.9;
        color: #555;
        white-space: pre-line;
        min-height: 120px;
    }

    .message-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #f0eee9;
        padding-top: 18px;
        margin-top: 25px;
    }

    .read-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #2f5d4e;
        background: #e7efe9;
        padding: 7px 12px;
        border-radius: 20px;
    }

    .back-button {
        color: #2f5d4e;
        background: #e7efe9;
        border: none;
        border-radius: 8px;
        padding: 9px 16px;
        font-size: 13px;
        text-decoration: none;
        transition: .2s;
    }

        .back-button:hover {
            background: #dce9df;
            color: #244b3e;
        }

    @@media (max-width: 576px) {
        .message-detail-card {
            padding: 18px;
        }

        .message-header,
        .message-footer {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="page-content-area">

    <div class="content-header-row">
        <div>
            <h2 class="page-title">Mesaj Detayı</h2>
            <p class="page-subtitle">
                Gelen mesajın detaylarını görüntüleyebilirsiniz.
            </p>
        </div>

        <a href="/Admin/Message/MessageList" class="back-button">
            ← Mesajlara Dön
        </a>
    </div>

    <div class="message-detail-card">

        <div class="message-header">
            <div>
                <h4 class="message-title">@Model.Subject</h4>
                <span class="message-date">
                    @Model.SendDate.ToString("dd MMMM yyyy, HH:mm")
                </span>
            </div>

            <span class="read-status">
                ✓ Okundu
            </span>
        </div>

        <div class="sender-info">

            <div class="sender-avatar">
                @(string.IsNullOrWhiteSpace(Model.SenderName)
                                ? "?"
                                : Model.SenderName.Substring(0, 1).ToUpper())
            </div>

            <div>
                <div class="sender-name">@Model.SenderName</div>
                <div class="sender-email">@Model.SenderEmail</div>
            </div>

        </div>

        <div class="message-content-title">
            MESAJ İÇERİĞİ
        </div>

        <div class="message-content">
            @Model.MessageDetail
        </div>

        <div class="message-footer">
            <span class="message-date">
                Gönderilme tarihi:
                @Model.SendDate.ToString("dd.MM.yyyy HH:mm")
            </span>

            <a href="/Admin/Message/MessageList" class="back-button">
                Gelen Kutusuna Dön
            </a>
        </div>

    </div>

</div>
