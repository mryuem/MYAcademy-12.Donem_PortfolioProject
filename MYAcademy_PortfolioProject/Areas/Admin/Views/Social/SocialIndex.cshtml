@model List<MYAcademy_PortfolioProject.Entities.SocialMedia>

@{
    ViewData["Title"] = "Sosyal Medya Hesapları";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<style>
    .social-page {
        background: #F7F6F2;
        padding: 25px;
        color: #2E312F;
    }

    .social-card {
        background: #FFFEFB;
        border: 1px solid #E7E4DD;
        border-radius: 14px;
        padding: 22px;
    }

    .social-page .table {
        vertical-align: middle;
    }

        .social-page .table th {
            color: #707772;
            font-weight: 600;
            font-size: 13px;
        }

        .social-page .table td {
            color: #2E312F;
            padding: 16px 10px;
        }

    .social-icon {
        background: #EEF4EF;
        color: #87A38F;
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 18px;
    }

    .btn-add {
        background: #9BB7A2;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 16px;
        text-decoration: none;
    }

        .btn-add:hover {
            background: #87A38F;
            color: white;
        }

    .btn-edit {
        background: #EEF4EF;
        color: #64836C;
        border: none;
        padding: 7px 12px;
        border-radius: 7px;
        text-decoration: none;
    }

    .btn-delete {
        background: #FDF0F0;
        color: #C98686;
        border: none;
        padding: 7px 12px;
        border-radius: 7px;
    }
</style>

<div class="social-page">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Sosyal Medya Hesapları</h3>
            <p class="text-muted mb-0">Sosyal medya bağlantılarınızı buradan yönetebilirsiniz.</p>
        </div>

        <a 
           asp-action="CreateSocial" class="btn-add">
            <i class="bi bi-plus-lg me-1"></i> Yeni Hesap Ekle
        </a>
    </div>

    <div class="social-card">

        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Sosyal Medya</th>
                        <th>İkon</th>
                        <th>Bağlantı</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.SocialMediaId</td>

                                <td class="fw-semibold">
                                    @item.SocialName
                                </td>

                                <td>
                                    <span class="social-icon">
                                        <i class="@item.SocialIcon"></i>
                                    </span>
                                </td>

                                <td>
                                    <a href="@item.SocialUrl" target="_blank"
                                       rel="noopener noreferrer"
                                       class="text-decoration-none text-secondary">
                                        Bağlantıyı Görüntüle
                                        <i class="bi bi-box-arrow-up-right ms-1"></i>
                                    </a>
                                </td>

                                <td class="text-end">
                                    <a asp-action="UpdateSocial"
                                       asp-route-id="@item.SocialMediaId"
                                       class="btn-edit">
                                        <i class="bi bi-pencil"></i> Düzenle
                                    </a>

                                    <form asp-action="DeleteSocial"
                                          asp-route-id="@item.SocialMediaId"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Bu hesabı silmek istediğinize emin misiniz?')">
                                        <button type="submit" class="btn-delete">
                                            <i class="bi bi-trash"></i> Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Henüz sosyal medya hesabı eklenmemiş.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>
