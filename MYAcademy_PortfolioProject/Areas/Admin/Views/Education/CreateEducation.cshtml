@model MYAcademy_PortfolioProject.Entities.Education

@{
    ViewData["Title"] = "Yeni Eğitim Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yeni Eğitim Ekle</h1>
            <p class="page-subtitle">Özgeçmişiniz için yeni bir eğitim veya kurs bilgisi oluşturun.</p>
        </div>
        <div class="header-actions">
            <a href="/Admin/Education/EducationIndex" class="btn-pastel-secondary">
                <i class="bi bi-arrow-left"></i>
                <span>Listeye Dön</span>
            </a>
        </div>
    </div>

    <div class="data-table-card p-4">
        <form asp-action="CreateEducation" asp-controller="Education" asp-area="Admin" method="post">

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Okul / Kurum / Başlık</label>
                    <input asp-for="EducationTitle" class="form-control-custom" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Bölüm / Alan / Alt Başlık</label>
                    <input asp-for="EducationDescription" class="form-control-custom" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Mini Başlık</label>
                    <input asp-for="badge" class="form-control-custom" />
                </div>
                



                <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                    <a href="/Admin/Education/EducationIndex" class="btn-pastel-secondary">İptal</a>
                    <button type="submit" class="btn-pastel-primary">
                        <i class="bi bi-check-lg"></i> Kaydet
                    </button>
                </div>
            </div>

        </form>
    </div>

</main>