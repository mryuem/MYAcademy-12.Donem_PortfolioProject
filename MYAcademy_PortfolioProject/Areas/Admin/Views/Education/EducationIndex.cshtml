@model List<MYAcademy_PortfolioProject.Entities.Education>

@{
    ViewData["Title"] = "Eğitimlerim";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <!-- Sayfa Başlığı ve Yeni Ekle Butonu -->
    <div class="content-header-row">
        <div>
            <h1 class="page-title">Eğitim Hayatım / Kurslar</h1>
            <p class="page-subtitle">Portfolyonuzda yer alan eğitim, sertifika ve kurs bilgilerini buradan yönetebilirsiniz.</p>
        </div>
        <div class="header-actions">
            <a href="/Admin/Education/CreateEducation" class="btn-pastel-primary">
                <i class="bi bi-plus-lg"></i>
                <span>Yeni Eğitim Ekle</span>
            </a>
        </div>
    </div>

    <!-- Eğitim Tablosu -->
    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Okul / Kurum / Başlık</th>
                        <th>Açıklama</th>
                        <th>Mini Başlık</th>
                        <th style="width: 100px; text-align: right;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int count = 0;
                        foreach (var item in Model)
                        {
                            count++;
                            <tr>
                                <td class="col-id">@count</td>
                                <td>
                                    <div class="experience-title-cell">
                                        <div class="exp-icon-bullet">
                                            <i class="bi bi-mortarboard"></i>
                                        </div>
                                        <span class="exp-title-text">@item.EducationTitle</span> <!-- Veya modelindeki ilgili başlık alanı -->
                                    </div>
                                </td>
                                <td>
                                    <span class="work-type-badge">
                                        @item.EducationDescription <!-- Alan / Alt başlık alanı yoksa uygun property ile değiştirebilirsin -->
                                    </span>
                                </td>
                                <td>
                                    <span class="work-type-badge">
                                        @item.badge <!-- Alan / Alt başlık alanı yoksa uygun property ile değiştirebilirsin -->
                                    </span>
                                </td>
                               
                                <td style="text-align: right;">
                                    <div class="row-actions-group justify-content-end">
                                        <a href="/Admin/Education/UpdateEducation/@item.EducationId" class="btn-action-icon btn-edit" title="Düzenle">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="/Admin/Education/DeleteEducation/@item.EducationId" class="btn-action-icon btn-delete" title="Sil"
                                           onclick="return confirm('Bu eğitimi silmek istediğinize emin misiniz?');">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Henüz kayıtlı bir eğitim bilgisi bulunmuyor.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>


    </div>

</main>